# URL publica da API FastAPI (opcional se usar proxy /api no Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Proxy server-side no Vercel (preferido em producao)
BACKEND_URL=http://127.0.0.1:8000

# Site principal (de onde o usuario vem)
NEXT_PUBLIC_MAIN_SITE_URL=https://sitecelestia.vercel.app
NEXT_PUBLIC_MAIN_SITE_NAME=Celestia

# Opcional: logo do site principal na barra de retorno
# NEXT_PUBLIC_MAIN_SITE_LOGO_URL=
